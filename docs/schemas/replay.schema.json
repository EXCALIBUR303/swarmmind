{
  "$defs": {
    "ReplayEnvInfo": {
      "properties": {
        "config": {
          "additionalProperties": true,
          "title": "Config",
          "type": "object"
        },
        "level": {
          "title": "Level",
          "type": "string"
        }
      },
      "required": [
        "level",
        "config"
      ],
      "title": "ReplayEnvInfo",
      "type": "object"
    },
    "ReplayFrame": {
      "description": "One step's delta (\u00a727.2). `t` is the POST-step index (1-based).",
      "properties": {
        "action": {
          "items": {
            "type": "integer"
          },
          "title": "Action",
          "type": "array"
        },
        "blocked_by_robot": {
          "items": {
            "type": "boolean"
          },
          "title": "Blocked By Robot",
          "type": "array"
        },
        "bumped_wall": {
          "items": {
            "type": "boolean"
          },
          "title": "Bumped Wall",
          "type": "array"
        },
        "comm_edges": {
          "items": {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "title": "Comm Edges",
          "type": "array"
        },
        "discovered": {
          "items": {
            "type": "integer"
          },
          "title": "Discovered",
          "type": "array"
        },
        "moved": {
          "items": {
            "type": "boolean"
          },
          "title": "Moved",
          "type": "array"
        },
        "newly_known": {
          "items": {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "title": "Newly Known",
          "type": "array"
        },
        "pos": {
          "items": {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "title": "Pos",
          "type": "array"
        },
        "rescued": {
          "items": {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "title": "Rescued",
          "type": "array"
        },
        "reward": {
          "items": {
            "type": "number"
          },
          "title": "Reward",
          "type": "array"
        },
        "reward_components": {
          "additionalProperties": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Reward Components",
          "type": "object"
        },
        "t": {
          "title": "T",
          "type": "integer"
        }
      },
      "required": [
        "t",
        "pos",
        "action",
        "moved",
        "blocked_by_robot",
        "bumped_wall",
        "reward",
        "reward_components"
      ],
      "title": "ReplayFrame",
      "type": "object"
    },
    "ReplayInitial": {
      "description": "State right after reset (\u00a727.2 `initial`). The reset-time sensing pass\nreveals cells that no frame's `newly_known` delta ever contains, so a\nviewer rebuilding the known map needs them: known(t) = initial.known_team\n\u222a \u22c3_{i<=t} frames[i].newly_known.",
      "properties": {
        "known_team": {
          "items": {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "title": "Known Team",
          "type": "array"
        }
      },
      "required": [
        "known_team"
      ],
      "title": "ReplayInitial",
      "type": "object"
    },
    "ReplayMapInfo": {
      "properties": {
        "hash": {
          "title": "Hash",
          "type": "string"
        },
        "height": {
          "title": "Height",
          "type": "integer"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "robot_starts": {
          "items": {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "title": "Robot Starts",
          "type": "array"
        },
        "targets": {
          "items": {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "title": "Targets",
          "type": "array"
        },
        "terrain": {
          "items": {
            "type": "string"
          },
          "title": "Terrain",
          "type": "array"
        },
        "width": {
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "hash",
        "width",
        "height",
        "terrain",
        "robot_starts",
        "targets"
      ],
      "title": "ReplayMapInfo",
      "type": "object"
    },
    "ReplayOutcome": {
      "properties": {
        "metrics": {
          "additionalProperties": true,
          "title": "Metrics",
          "type": "object"
        },
        "steps": {
          "title": "Steps",
          "type": "integer"
        },
        "success": {
          "title": "Success",
          "type": "boolean"
        }
      },
      "required": [
        "success",
        "steps",
        "metrics"
      ],
      "title": "ReplayOutcome",
      "type": "object"
    },
    "ReplayPolicyInfo": {
      "properties": {
        "checkpoint_step": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checkpoint Step"
        },
        "eval_seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Eval Seed"
        },
        "kind": {
          "enum": [
            "random",
            "heuristic",
            "ippo",
            "mappo"
          ],
          "title": "Kind",
          "type": "string"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "stochastic": {
          "default": true,
          "title": "Stochastic",
          "type": "boolean"
        }
      },
      "required": [
        "kind"
      ],
      "title": "ReplayPolicyInfo",
      "type": "object"
    }
  },
  "properties": {
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "env": {
      "$ref": "#/$defs/ReplayEnvInfo"
    },
    "frames": {
      "items": {
        "$ref": "#/$defs/ReplayFrame"
      },
      "title": "Frames",
      "type": "array"
    },
    "initial": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReplayInitial"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "map": {
      "$ref": "#/$defs/ReplayMapInfo"
    },
    "outcome": {
      "$ref": "#/$defs/ReplayOutcome"
    },
    "policy": {
      "$ref": "#/$defs/ReplayPolicyInfo"
    },
    "replay_id": {
      "title": "Replay Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "replay_id",
    "created_at",
    "env",
    "map",
    "policy",
    "frames",
    "outcome"
  ],
  "title": "Replay",
  "type": "object"
}
